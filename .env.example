# API security
NIFTY_API_KEY=replace-with-random-key

# PostgreSQL connection
DATABASE_URI=postgresql://user:password@localhost:5432/nifty50
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nifty50
DB_USER=postgres
DB_PASSWORD=replace-password

# Market data provider
UPSTOX_ACCESS_TOKEN=

# News providers
GUARDIAN_KEY=
NEWSAPI_KEY=
GNEWS_KEY=

# Local data paths
DATA_FOLDER=/app/archive/*.csv

# Optional news/model controls
USE_FINBERT=false
SWEEP_MODE=incremental
LOOKBACK_HOURS=2
NEWS_REQUEST_TIMEOUT_SECONDS=30
NEWSAPI_MAX_PAGES_PER_QUERY=2
